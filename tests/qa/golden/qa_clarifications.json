  "state_and_value_digests": {
    "identity_relations": [
      {
        "differ": [
          "receipt_attempt_1",
          "receipt_state_after_changed"
        ],
        "why": "state_after_hash is identity"
      },
      {
        "equal": [
          "receipt_attempt_1",
          "receipt_duration_changed"
        ],
        "why": "duration_ms is custody"
      },
      {
        "differ": [
          "receipt_attempt_1",
          "receipt_key_changed"
        ],
        "why": "the idempotency key is identity"
      },
      {
        "differ": [
          "receipt_attempt_1",
          "receipt_attempt_2"
        ],
        "why": "the attempt number is identity"
      }
    ],
    "rule": "state_before_hash, state_after_hash and Checkpoint.state_hash are opaque rcv1 hashes of whatever the producer defines as the observable state; qa/v1 specifies their shape, their identity status and one relation (a blocked action leaves them equal), not their derivation. Value digests are defined in golden/qa_canon_vectors_addendum.json."
  },
  "version_note": "clarifications_version 1. Additive to qa/v1: no entry restates or replaces an entry of golden/qa.json, and nothing here changes a hash defined there. A later version adds entries and never edits one."
}
