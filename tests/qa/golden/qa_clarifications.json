            "attempt": 1,
            "idempotency_key": "idem-s2-1",
            "run_id": "run-1",
            "step_id": "s2"
          }
        ],
        "violations": [],
        "why": "different steps carry different keys"
      },
      {
        "id": "key_changes_between_attempts",
        "receipts": [
          {
            "attempt": 1,
            "idempotency_key": "idem-s1-1",
            "run_id": "run-1",
            "step_id": "s1"
          },
          {
            "attempt": 2,
            "idempotency_key": "idem-s1-other",
            "run_id": "run-1",
            "step_id": "s1"
          }
        ],
        "violations": [
          "IDEMPOTENCY_KEY_CHANGED_ACROSS_ATTEMPTS"
        ],
        "why": "a replay that arrives under a new key cannot be recognised"
      },
      {
        "id": "key_shared_by_two_steps",
        "receipts": [
          {
            "attempt": 1,
            "idempotency_key": "idem-s1-1",
            "run_id": "run-1",
            "step_id": "s1"
          },
          {
            "attempt": 1,
            "idempotency_key": "idem-s1-1",
            "run_id": "run-1",
            "step_id": "s2"
          }
        ],
        "violations": [
          "IDEMPOTENCY_KEY_SHARED_ACROSS_STEPS"
        ],
        "why": "two steps of one run must not share a key: the target would treat the second as a replay of the first"
      }
    ],
